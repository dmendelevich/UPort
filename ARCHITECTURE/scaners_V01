    signal_price_to_sma200_pct
FROM public.tickers
WHERE exchange_mic IN ('XNGS', 'XNYS', 'XNAS') 
  AND daily_turnover_usd > 20000000           -- Снизили до $20 млн для зрячего поиска в S&P 400
  AND return_on_equity > 0.15                 
  AND debt_to_equity < 1.5                    
  AND revenue_cagr_3y > 0.05                  
  AND signal_price_to_sma200_pct < 0.00       -- Идеальный поиск недооцененного качества
  AND pe_trailing > 0                         
ORDER BY return_on_equity DESC;
```
